# Copie para .env e ajuste. O .env não vai para o git.

# Curadoria por LLM (obrigatória; não há curadoria local): gemini (padrão) | claude
# Sem a chave do provedor escolhido, o processamento falha e a API recusa novos projetos.
LLM_PROVIDER=gemini

# Gemini (Google AI Studio). Prefira exportar GEMINI_API_KEY no shell em vez de gravá-la aqui.
# Verifique o plano do projeto em https://aistudio.google.com/projects: no plano gratuito não há cobrança,
# mas o Google pode usar o conteúdo enviado para melhorar os produtos.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Usado quando o modelo principal esgota a cota (429).
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Vazio = padrão do modelo; low | medium | high
GEMINI_THINKING_LEVEL=
# Passo 2 da curadoria por IA: avaliação visual com folhas de contato (só com LLM_PROVIDER=gemini).
GEMINI_VISUAL=true

# Claude (opcional; requer `pip install -e '.[claude]'`)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
CLAUDE_EFFORT=medium

# faster-whisper: tiny | base | small | medium (CPU, int8). "small" é um bom equilíbrio com ~3 GB de RAM.
WHISPER_MODEL=small
# Vazio = detecção automática; ex.: pt, en
WHISPER_LANGUAGE=

# Onde os projetos e arquivos gerados são gravados (relativo ao diretório de execução).
DATA_DIR=./data

# Fonte TTF/OTF das legendas (vazio = procura automática).
CAPTION_FONT=

# Executáveis do FFmpeg (nome no PATH ou caminho completo).
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# API: token de administrador exigido em Authorization: Bearer <token>
# (vazio = sem autenticação; só para testes locais). Sem cota.
API_TOKEN=
# 10 GiB e 3 h
MAX_UPLOAD_BYTES=10737418240
MAX_VIDEO_SECONDS=10800

# Contas, banco, cotas e limpeza
# Vazio = SQLite em DATA_DIR/clipstudio.db. Produção: postgresql+psycopg://usuario:senha@host/banco
DATABASE_URL=
# Vazio = gerado e guardado em DATA_DIR/jwt_secret. Gere com: openssl rand -base64 48
JWT_SECRET=
JWT_DAYS=30
# true = cadastro aberto em POST /auth/register; false = contas via `clipstudio user-add`
ALLOW_SIGNUP=false
# Cotas por usuário (0 = sem limite)
QUOTA_PROJECTS_PER_DAY=20
QUOTA_MINUTES_PER_DAY=180
# Limpeza (0 = nunca): apaga o vídeo original após N dias (cortes ficam); apaga o projeto após M dias.
SOURCE_RETENTION_DAYS=0
PROJECT_RETENTION_DAYS=0
